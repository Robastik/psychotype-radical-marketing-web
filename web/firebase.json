{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "verify.html"
    ],
    "rewrites": [
      {
        "source": "/verify/**",
        "function": {
          "functionId": "ssrVerifyPage"
        }
      },
      {
        "source": "/verify",
        "function": {
          "functionId": "ssrVerifyPage"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}
