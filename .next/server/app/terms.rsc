ldren":"eyeCARD"}]," (далее — Исполнитель). Исполнитель предоставляет пользователю (далее — Заказчик) доступ к автоматизированной AI-платформе нейромаркетингового аудита карточек товаров на маркетплейсах."]}]]}],["$","section",null,{"style":{"display":"flex","flexDirection":"column","gap":"12px"},"children":[["$","h2",null,{"style":{"fontSize":"18px","fontWeight":"600"},"children":"2. Права Исполнителя на результаты анализа"}],["$","p",null,{"style":{"fontSize":"15px","lineHeight":"1.6"},"children":["Поскольку аудит проводится исключительно на основе изображений товаров и текстовых описаний, находящихся в свободном, открытом доступе на страницах маркетплейсов, ",["$","strong",null,{"children":"Сервис оставляет за собой право использовать результаты любого проведенного анализа по своему усмотрению"}],". Это включает, но не ограничивается: публикацией результатов анализа (Визуальных Паспортов) в открытом доступе на данном сайте, демонстрацией их в качестве публичных кейсов, а также использованием в рекламных и образовательных материалах Исполнителя."]}]]}],"$L6","$L7","$L8","$L9"]}],"$La"]}]]}],["$Lb"],"$Lc"]}],{},null,false,null]},null,false,"$d"]},null,false,null],"$Le",false]],"m":"$undefined","G":["$f",["$L10"]],"S":true,"h":null,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"qqUmNIaBBGyr6M0p8Athi"}
