```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
.next/
.nuxt/
out/
public/build/
static/css/
static/js/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.env
.env.local
.env.*
.env.local.*
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.hypothesis/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?
```

# Editor and IDE specific
.idea/
.vscode/
*.swp
*.swo
*~
```